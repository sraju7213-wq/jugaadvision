<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JugaadVision.App</RootNamespace>
    <AssemblyName>JugaadVision.App</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!--
      Avalonia 12.x ships the developer tools in this package; there is no
      12.x build of the old separate `Avalonia.Diagnostics` package (it stops at 11.3.22).
      Debug builds get the package's full default asset set, which is what makes
      AppBuilder.WithDeveloperTools() available to Program.cs under #if DEBUG.
    -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' == 'Debug'">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- App -> Core, AI, Models, Storage, Platform (composition root lives here) -->
    <ProjectReference Include="..\JugaadVision.Core\JugaadVision.Core.csproj" />
    <ProjectReference Include="..\JugaadVision.AI\JugaadVision.AI.csproj" />
    <ProjectReference Include="..\JugaadVision.Models\JugaadVision.Models.csproj" />
    <ProjectReference Include="..\JugaadVision.Storage\JugaadVision.Storage.csproj" />
    <ProjectReference Include="..\JugaadVision.Platform\JugaadVision.Platform.csproj" />
  </ItemGroup>
</Project>
