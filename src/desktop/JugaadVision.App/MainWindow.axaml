<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:JugaadVision.App.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="JugaadVision.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="JugaadVision"
        Width="1440" Height="900"
        MinWidth="1280" MinHeight="720"
        Background="{StaticResource JgBackgroundBrush}">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Grid RowDefinitions="*,26">

        <!-- Shell: sidebar navigation + content, standing in for the spec's NavigationView. -->
        <SplitView Grid.Row="0"
                   x:DataType="vm:MainWindowViewModel"
                   IsPaneOpen="True"
                   OpenPaneLength="{StaticResource JgSidebarWidth}"
                   PanePlacement="Left"
                   DisplayMode="Inline"
                   Background="{StaticResource JgSurfaceBrush}">

            <SplitView.Pane>
                <DockPanel LastChildFill="True">

                    <!-- Brand -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,28" Spacing="2">
                        <TextBlock Text="JugaadVision"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource JgTextPrimaryBrush}" />
                        <TextBlock Text="AI Creative Workstation"
                                   FontSize="11"
                                   Foreground="{StaticResource JgTextSecondaryBrush}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Items}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItem">
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,0">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontSize="15"
                                               Width="18"
                                               Foreground="{StaticResource JgTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="13.5"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource JgTextPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>
            </SplitView.Pane>

            <!-- Content -->
            <Grid Background="{StaticResource JgBackgroundBrush}"
                  RowDefinitions="48,*">

                <!-- Top bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource JgSurfaceBrush}"
                        BorderBrush="{StaticResource JgBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding PageTitle}"
                               Margin="24,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource JgTextPrimaryBrush}" />
                </Border>

                <!-- Page host: each navigation target renders here in later phases. -->
                <Border Grid.Row="1" Margin="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                        <TextBlock Text="Shell scaffolded"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource JgTextPrimaryBrush}" />
                        <TextBlock Text="Home, Generate, Models, Library, History, Tasks and Settings land in the next phases."
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource JgTextSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </Grid>
        </SplitView>

        <!-- Status bar -->
        <Border Grid.Row="1"
                Background="{StaticResource JgSurfaceBrush}"
                BorderBrush="{StaticResource JgBorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}"
                       Margin="16,0"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource JgTextSecondaryBrush}" />
        </Border>

    </Grid>
</Window>
