# =============================================================================
# VERCEL SERVER-SIDE ENVIRONMENT VARIABLES
# =============================================================================
# Add these variables directly into Vercel:
# Project Settings → Environment Variables → Add Variable
#
# NOTE: Do NOT prefix sensitive variables with VITE_ to prevent them
# from being exposed to the client-side JavaScript bundle.
# =============================================================================

# 1. OpenRouter API Keys (Individual numbered keys or comma-separated)
# OPENROUTER_API_KEY_1=...
# OPENROUTER_API_KEY_2=...

# 2. NVIDIA NIM API Keys
# NVIDIA_NIM_API_KEY_1=...
# NVIDIA_NIM_API_KEY_2=...

# 3. Hugging Face API Token (Free Vision & Multimodal)
# HUGGINGFACE_API_KEY=...

# 4. Cloudflare Workers AI Token
# CLOUDFLARE_API_TOKEN=...

# 5. Remove.bg API Key (Isolated to Server Gateway)
# REMOVE_BG_API_KEY=...

# 6. Global Configuration
PREFER_FREE_MODELS=true
AI_CACHE_TTL_MS=3600000
