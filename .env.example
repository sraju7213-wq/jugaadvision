# =============================================================================
# JugaadVision Environment Variables
# =============================================================================
# Copy this file to .env.local for local development
# For Vercel: Add these variables in Project Settings → Environment Variables
# =============================================================================

# Gemini API Keys (comma-separated for rotation)
# Get keys from: https://aistudio.google.com/apikey
VITE_GEMINI_FREE_KEYS=your_free_key_1,your_free_key_2
VITE_GEMINI_PREMIUM_KEYS=your_premium_key_1,your_premium_key_2

# =============================================================================
# Model Configuration (optional - defaults are provided in code)
# =============================================================================

# Low-cost model for prompt generation/enhancement
VITE_LOW_COST_MODEL=gemini-2.0-flash-lite

# Primary model for complex tasks
VITE_PRIMARY_MODEL=gemini-2.0-flash

# Image generation model
VITE_IMAGE_MODEL=imagen-3.0-generate-001

# =============================================================================
# Rate Limiting Configuration (optional)
# =============================================================================

# Max concurrent text requests (default: 8)
VITE_MAX_CONCURRENT_TEXT=8

# Max concurrent image requests (default: 3)
VITE_MAX_CONCURRENT_IMAGE=3
