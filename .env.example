# =============================================================================
# JugaadVision Server Environment Variables
# Modular AI Provider System
# =============================================================================

# OpenRouter API Keys (Individual numbered keys or comma-separated)
OPENROUTER_API_KEY_1=your_openrouter_key_1
OPENROUTER_API_KEY_2=your_openrouter_key_2
OPENROUTER_API_KEY_3=your_openrouter_key_3
OPENROUTER_API_KEY_4=your_openrouter_key_4
OPENROUTER_API_KEY_5=your_openrouter_key_5

# NVIDIA NIM API Keys (Individual numbered keys or comma-separated)
NVIDIA_NIM_API_KEY_1=your_nim_key_1
NVIDIA_NIM_API_KEY_2=your_nim_key_2
NVIDIA_NIM_API_KEY_3=your_nim_key_3
NVIDIA_NIM_API_KEY_4=your_nim_key_4
NVIDIA_NIM_API_KEY_5=your_nim_key_5

# Hugging Face API Tokens (For Free Vision Models)
HUGGINGFACE_API_KEY=your_hf_token_here

# Cloudflare Workers AI Tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_token_here

# Remove.bg Background Removal API Key (Isolated to Server Gateway)
REMOVE_BG_API_KEY=your_remove_bg_key_here

# Model Routing Configuration
PREFER_FREE_MODELS=true
AI_CACHE_TTL_MS=3600000
