# Serverless bundles under api/ are COMMITTED ON PURPOSE.
# Vercel determines which /api/* functions exist from the repo file tree BEFORE
# `npm run build` runs, so bundles generated at build time (scripts/bundle-api.mjs)
# are never deployed and every /api/* route returns 404 in production.
# Refresh them with `npm run bundle:api` and commit the result whenever api-src/
# or server/ changes. Do NOT re-add an `api/**/*.js` ignore rule here.
# Generated Tailwind output (regenerated by predev/prebuild from index.css)
public/styles.css
.vercel
.kilo
.local-models
.env*

