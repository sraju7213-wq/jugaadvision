{
  "name": "jugaad-visuals-update",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "predev": "tailwindcss -i ./src/index.css -o ./public/styles.css --minify",
    "prebuild": "tailwindcss -i ./src/index.css -o ./public/styles.css --minify && node scripts/bundle-api.mjs",
    "bundle:api": "node scripts/bundle-api.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --build tsconfig.base.json --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "mutation:ci": "stryker run --concurrency 2",
    "verify": "npm run typecheck && npm run build && npm run bundle:api",
    "preview": "vite preview"
  },
  "dependencies": {
    "ai": "^5.0.109",
    "lucide-react": "^0.560.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "6.22.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.3"
  }
}
