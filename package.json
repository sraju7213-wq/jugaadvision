{
  "name": "jugaad-visuals-update",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "tailwindcss -i ./src/index.css -o ./public/styles.css --minify",
    "prebuild": "tailwindcss -i ./src/index.css -o ./public/styles.css --minify && node scripts/bundle-api.mjs",
    "bundle:api": "node scripts/bundle-api.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:android": "CAPACITOR_BUILD=true vite build && cap sync android",
    "build:apk": "CAPACITOR_BUILD=true vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "ai": "^5.0.109",
    "lucide-react": "^0.560.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "6.22.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
